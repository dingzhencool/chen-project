# ==========================================================================
# 企业级 RAG 知识库 - 前端（Vue 3 + Vite）环境变量模板
# 使用方法：
#   1. 复制本文件为 web/.env.development   （本地开发读取）
#   2. 如需打包生产，再复制一份为 web/.env.production
#   3. Vite 要求所有自定义变量必须以 VITE_ 开头，否则不会注入到前端代码
# ==========================================================================

# --------------------------------------------------------------------------
# 一、后端 API 地址（开发阶段走 Vite 代理，生产阶段指向实际后端域名）
# --------------------------------------------------------------------------
# 说明：
#   - 本地开发：保持 http://127.0.0.1:8000，Vite 会把 /api 代理到这里（见 vite.config.js proxy 配置）
#   - 同机部署生产：可以填 http://127.0.0.1:8000，配合 nginx 反向代理
#   - 分离部署：填写完整可访问域名，如 https://api.yourcompany.com
VITE_API_TARGET=http://127.0.0.1:8000

# --------------------------------------------------------------------------
# 二、站点基础信息
# --------------------------------------------------------------------------
# 页面标题的默认值，会显示在浏览器标签页
VITE_APP_TITLE=企业级 RAG 知识库
# 公司/产品品牌名，展示在侧边栏 Logo 旁（可以留空使用默认）
VITE_APP_BRAND=RAG KB
# 客服/联系邮箱，404 等页面可选显示（可以留空）
VITE_APP_CONTACT=support@example.com

# --------------------------------------------------------------------------
# 三、功能开关（可选，预留）
# --------------------------------------------------------------------------
# 是否启用"上传文档"入口。MVP 阶段 true，生产权限控制时可关闭
VITE_FEATURE_UPLOAD=true
# 是否显示"引用来源"面板，默认开启
VITE_FEATURE_SHOW_SOURCES=true
# 是否允许匿名访问（false 表示强制登录；true 保留公共页面）
VITE_ALLOW_ANONYMOUS=false

# --------------------------------------------------------------------------
# 四、对话/流式参数
# --------------------------------------------------------------------------
# SSE 流式响应超时（毫秒）。长回答可适当调大
VITE_CHAT_STREAM_TIMEOUT=300000
# 单条对话上下文保留的历史消息条数，防止上下文过长爆 token
VITE_CHAT_HISTORY_LIMIT=20
# 发送按钮快捷键：true=Enter 发送 / Shift+Enter 换行，false 反之
VITE_CHAT_SEND_ON_ENTER=true
